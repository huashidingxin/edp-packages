{
  "name": "@edp/packages",
  "version": "0.1.0",
  "private": true,
  "description": "EDP shared packages workspace",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm run typecheck && pnpm run test",
    "release:check": "node scripts/assert-publishable.mjs",
    "release:dry-run": "pnpm run check && pnpm run release:check && pnpm publish -r --dry-run --no-git-checks",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm run check && pnpm run release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  }
}
