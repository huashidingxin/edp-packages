{
  "name": "@edp/website-ui",
  "version": "0.1.0",
  "private": false,
  "description": "EDP website Vue component and interaction library",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huashidingxin/edp-packages.git",
    "directory": "website/ui"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist",
    "BLOCKS_SPEC.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./client": {
      "types": "./dist/api/client.d.ts",
      "import": "./dist/api/client.js"
    },
    "./auth": {
      "types": "./dist/api/auth.d.ts",
      "import": "./dist/api/auth.js"
    },
    "./theme": {
      "types": "./dist/api/theme.d.ts",
      "import": "./dist/api/theme.js"
    },
    "./navigation": {
      "types": "./dist/api/navigation.d.ts",
      "import": "./dist/api/navigation.js"
    },
    "./preview": {
      "types": "./dist/api/preview.d.ts",
      "import": "./dist/api/preview.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*.vue.d.ts",
      "import": "./dist/blocks/*.vue"
    },
    "./session": {
      "types": "./dist/auth/session.d.ts",
      "import": "./dist/auth/session.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/copy-package-assets.mjs",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify/vue": "^5.0.1",
    "@lucide/vue": "^1.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "qrcode-generator": "^2.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7"
  }
}
