{
  "name": "@edp/website-ui",
  "version": "0.1.0",
  "private": false,
  "description": "EDP website Vue component and interaction library",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huashidingxin/edp-packages.git",
    "directory": "website/ui"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "src",
    "BLOCKS_SPEC.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./client": {
      "types": "./src/api/client.ts",
      "import": "./src/api/client.ts"
    },
    "./auth": {
      "types": "./src/api/auth.ts",
      "import": "./src/api/auth.ts"
    },
    "./theme": {
      "types": "./src/api/theme.ts",
      "import": "./src/api/theme.ts"
    },
    "./navigation": {
      "types": "./src/api/navigation.ts",
      "import": "./src/api/navigation.ts"
    },
    "./preview": {
      "types": "./src/api/preview.ts",
      "import": "./src/api/preview.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts"
    },
    "./primitives/*": {
      "types": "./src/primitives/*.vue",
      "import": "./src/primitives/*.vue"
    },
    "./blocks/*": {
      "types": "./src/blocks/*.vue",
      "import": "./src/blocks/*.vue"
    },
    "./session": {
      "types": "./src/auth/session.ts",
      "import": "./src/auth/session.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify/vue": "^5.0.1",
    "@lucide/vue": "^1.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "qrcode-generator": "^2.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7"
  }
}
